[
  {
    "name": "moi_get_account",
    "title": "Get MOI account",
    "description": "Read a MOI participant account: its nonce, whether it is registered on chain, and its balance in every asset it holds. Takes a participant id (0x-prefixed). Use this to check a balance before proposing a transfer.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "address": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]+$",
          "description": "Account address (0x…). Required; ask moi_wallet_status for the paired wallet's address if the user means their own."
        }
      },
      "required": [
        "address"
      ],
      "additionalProperties": false,
      "$schema": "https://json-schema.org/draft/2020-12/schema"
    },
    "annotations": {
      "readOnlyHint": true,
      "openWorldHint": true
    },
    "execution": {
      "taskSupport": "forbidden"
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "address": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]+$"
        },
        "nonce": {
          "type": "number"
        },
        "balances": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "assetId": {
                "type": "string",
                "pattern": "^0x[0-9a-fA-F]+$"
              },
              "symbol": {
                "type": "string"
              },
              "amount": {
                "type": "string",
                "pattern": "^\\d+(\\.\\d+)?$"
              }
            },
            "required": [
              "assetId",
              "amount"
            ],
            "additionalProperties": false
          }
        },
        "isRegistered": {
          "type": "boolean"
        }
      },
      "required": [
        "address",
        "nonce",
        "balances",
        "isRegistered"
      ],
      "additionalProperties": false,
      "$schema": "https://json-schema.org/draft/2020-12/schema"
    }
  },
  {
    "name": "moi_get_asset",
    "title": "Get MOI asset",
    "description": "Read a MOI native asset by its asset id: symbol, standard (MAS0/MAS1/MAS2), circulating supply, decimal dimension, and owner. Use this to learn an asset's dimension before interpreting raw balances.",
