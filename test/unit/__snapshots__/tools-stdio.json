  {
    "name": "moi_mint",
    "title": "Mint tokens of a MOI asset",
    "description": "Mint tokens of an asset you manage, to yourself or another account. Creating an asset sets a maximum supply but mints nothing — until you mint, circulating supply is 0, you hold none, and the asset does not appear in a wallet. Works for MAS0 and MAS2 assets; the native asset (KMOI) cannot be minted and other standards are refused with an explanation before anything reaches your phone. Sent to MOI Wallet for approval.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "assetId": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]+$",
          "description": "The asset to mint. You must be its manager."
        },
        "amount": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^\\d+(\\.\\d+)?$"
            },
            {
              "type": "number"
            }
          ],
          "description": "How many tokens to mint, scaled by the asset's decimals."
        },
        "to": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]+$",
          "description": "Recipient. Defaults to the connected wallet."
