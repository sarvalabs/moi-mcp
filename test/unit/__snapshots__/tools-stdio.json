      "type": "object",
      "properties": {
        "assetId": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]+$"
        }
      },
      "required": [
        "assetId"
      ],
      "additionalProperties": false,
      "$schema": "https://json-schema.org/draft/2020-12/schema"
    },
    "annotations": {
      "readOnlyHint": true,
      "openWorldHint": true
    },
    "execution": {
      "taskSupport": "forbidden"
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "assetId": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]+$"
        },
        "symbol": {
          "type": "string"
        },
        "standard": {
          "type": "string"
        },
        "supply": {
          "type": "string",
          "pattern": "^\\d+(\\.\\d+)?$"
        },
        "decimals": {
          "type": "number"
        },
        "dimension": {
          "type": "number"
        },
        "owner": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]+$"
        },
        "isLogical": {
          "type": "boolean"
        },
        "logicId": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]+$"
        }
      },
      "required": [
        "assetId",
        "symbol",
        "standard",
        "supply",
        "decimals",
        "dimension",
        "owner",
        "isLogical"
      ],
      "additionalProperties": false,
      "$schema": "https://json-schema.org/draft/2020-12/schema"
    }
  },
  {
    "name": "moi_get_interaction",
    "title": "Get MOI interaction",
    "description": "Look up a MOI interaction (MOI's term for a transaction) by hash. Returns its status (pending/success/failed), sender, operations and fuel used. Use this after moi_transfer to confirm the interaction landed.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "hash": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]+$"
        }
      },
      "required": [
        "hash"
      ],
      "additionalProperties": false,
      "$schema": "https://json-schema.org/draft/2020-12/schema"
    },
    "annotations": {
      "readOnlyHint": true,
      "openWorldHint": true
    },
    "execution": {
      "taskSupport": "forbidden"
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "hash": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]+$"
        },
        "status": {
          "type": "string",
          "enum": [
            "pending",
            "success",
            "failed",
            "unknown"
          ]
        },
        "sender": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]+$"
        },
        "operations": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string"
              },
              "payload": {
                "type": "object",
                "additionalProperties": {}
              }
            },
            "required": [
              "type",
              "payload"
            ],
            "additionalProperties": false
          }
        },
        "fuelUsed": {
          "type": "number"
        },
        "blockHeight": {
          "type": "number"
        },
        "receipt": {
          "type": "object",
          "additionalProperties": {}
        }
      },
      "required": [
        "hash",
        "status",
        "sender",
        "operations"
      ],
      "additionalProperties": false,
      "$schema": "https://json-schema.org/draft/2020-12/schema"
    }
  },
  {
    "name": "moi_get_logic",
    "title": "Get MOI logic",
    "description": "Read a deployed MOI logic (MOI's term for a smart contract) by logic id. Returns its callable routines with their input and output types. Call this before moi_call_logic so you know the routine name and argument order.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "logicId": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]+$"
        }
      },
      "required": [
        "logicId"
      ],
      "additionalProperties": false,
      "$schema": "https://json-schema.org/draft/2020-12/schema"
    },
    "annotations": {
      "readOnlyHint": true,
      "openWorldHint": true
    },
    "execution": {
      "taskSupport": "forbidden"
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "logicId": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]+$"
        },
        "name": {
          "type": "string"
        },
        "routines": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "invoke",
                  "deploy",
                  "enlist",
                  "view"
                ]
              },
              "inputs": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "type": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "name",
                    "type"
                  ],
                  "additionalProperties": false
                }
              },
              "outputs": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "type": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "name",
                    "type"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "name",
              "kind",
              "inputs",
              "outputs"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "logicId",
        "routines"
      ],
      "additionalProperties": false,
      "$schema": "https://json-schema.org/draft/2020-12/schema"
    }
  },
  {
    "name": "moi_resolve_agent",
    "title": "Resolve MOI agent",
    "description": "Look up an AI agent in the MOI agent registry by handle, name, or address. Returns the agent's on-chain id, wallet address, capabilities and service endpoint. Use before paying or calling an agent. Returns found:false when the agent is not registered — that is a normal answer, not an error.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "query"
      ],
      "additionalProperties": false,
      "$schema": "https://json-schema.org/draft/2020-12/schema"
    },
    "annotations": {
      "readOnlyHint": true,
      "openWorldHint": true
    },
    "execution": {
      "taskSupport": "forbidden"
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "found": {
          "type": "boolean"
        },
        "agentId": {
          "type": "string"
        },
        "address": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]+$"
        },
        "name": {
          "type": "string"
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "endpoint": {
          "type": "string",
          "format": "uri"
        },
        "metadata": {
          "type": "object",
          "additionalProperties": {}
        }
      },
      "required": [
        "found"
      ],
      "additionalProperties": false,
      "$schema": "https://json-schema.org/draft/2020-12/schema"
    }
  },
  {
    "name": "moi_list_agents",
    "title": "List MOI agents",
    "description": "Page through the MOI agent registry: every registered agent, or only those a given account registered. Each entry has the agent id, owner, wallet address, status and service URL. Use moi_resolve_agent for one agent's full profile and card.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "owner": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]+$",
          "description": "Only agents registered by this account (a participant id). Leave it out to page through every agent."
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "default": 0,
          "description": "Where to start; pass back nextOffset from the previous page."
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50,
          "default": 20
        }
      },
      "additionalProperties": false,
      "$schema": "https://json-schema.org/draft/2020-12/schema"
    },
    "annotations": {
      "readOnlyHint": true,
      "openWorldHint": true
    },
    "execution": {
      "taskSupport": "forbidden"
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "agents": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "agentId": {
                "type": "string"
              },
              "found": {
                "type": "boolean"
              },
              "owner": {
                "type": "string",
                "pattern": "^0x[0-9a-fA-F]+$"
              },
              "address": {
                "type": "string",
                "pattern": "^0x[0-9a-fA-F]+$"
              },
              "status": {
                "type": "string"
              },
              "url": {
                "type": "string"
              },
              "cardUri": {
                "type": "string"
              },
              "score": {
                "type": "string"
              },
              "createdAt": {
                "type": "string"
              }
            },
            "required": [
              "agentId",
              "found"
            ],
            "additionalProperties": false
          }
        },
        "offset": {
          "type": "integer"
        },
        "limit": {
          "type": "integer"
        },
        "total": {
          "type": "integer"
        },
        "nextOffset": {
          "type": "integer"
        }
      },
      "required": [
        "agents",
        "offset",
        "limit"
      ],
      "additionalProperties": false,
      "$schema": "https://json-schema.org/draft/2020-12/schema"
    }
  },
  {
    "name": "moi_connect_wallet",
    "title": "Connect MOI Wallet",
    "description": "Pair MOI Wallet on your phone with this server over WalletConnect. Returns a QR code to scan. Approval happens on the phone, so this returns immediately — call moi_wallet_status afterwards to confirm the pairing landed. No private key ever reaches this server.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "network": {
          "type": "string",
          "enum": [
            "voyage",
            "mainnet",
            "custom"
          ],
          "default": "voyage"
        },
        "qr": {
          "type": "boolean",
          "default": true
        }
      },
      "additionalProperties": false,
      "$schema": "https://json-schema.org/draft/2020-12/schema"
    },
    "annotations": {
      "readOnlyHint": false,
      "openWorldHint": true,
      "idempotentHint": true
    },
    "execution": {
      "taskSupport": "forbidden"
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "awaiting_scan",
            "connected",
            "already_connected"
          ]
        },
        "uri": {
          "type": "string"
        },
        "expiresAt": {
          "type": "number"
        },
        "account": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]+$"
        },
        "network": {
          "type": "string",
          "enum": [
            "voyage",
            "mainnet",
            "custom"
          ]
        }
      },
      "required": [
        "status"
      ],
      "additionalProperties": false,
      "$schema": "https://json-schema.org/draft/2020-12/schema"
    }
  },
